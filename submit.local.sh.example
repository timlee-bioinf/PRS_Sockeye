#!/usr/bin/env bash
# Template for your personal launcher. Copy it, fill in your values, run it:
#   cp submit.local.sh.example submit.local.sh && chmod +x submit.local.sh
# submit.local.sh is git-ignored, so your account/paths are never committed.
#
#   ./submit.local.sh          submit the pipeline (prep + SLURM DAG)
#   ./submit.local.sh setup    build the ancestry reference cache for $TRAIT
#                              (multi-ancestry only; once per trait)
#   ./submit.local.sh check    print the resolved config, submit nothing
#   ./submit.local.sh rsids    one-time: convert position-only weights files in
#                              $WEIGHTS_ROOT/$TRAIT/pgs_raw/ into rsID weights
#                              files. Submits a SLURM job, WAITS for it (keep the
#                              terminal open), then copies the results into
#                              $WEIGHTS_ROOT/$TRAIT/. See slurm/resolve_pgs_rsids.slurm.
#   ./submit.local.sh rsids-copy  redo just the copy step (e.g. if the terminal
#                              closed while `rsids` was waiting)
#   ./submit.local.sh refids   one-time: give the reference panel (positional IDs,
#                              e.g. pgsc_calc's HGDP+1kGP) rsIDs from INFO/gnomad_ID.
#                              Submits a job, WAITS, then writes <panel>_rsid.pvar.zst
#                              next to the panel. Then set ANCESTRY_REF_PFILE to
#                              the _rsid prefix. See slurm/rsid_reference.slurm.
#   ./submit.local.sh refids-copy redo just the copy step for `refids`
#
# Anything left unset falls back to the default in config.sh.
set -euo pipefail
HERE="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- SLURM ---
export SBATCH_ACCOUNT="your-allocation"
# export MAIL_USER="you@example.com"

# --- read-only inputs (shared storage is fine) ---
export IMPUTE_DIR="/path/to/imputation"            # contains chr_<N>/chr<N>.dose.vcf.gz

# --- weights: $WEIGHTS_ROOT/<TRAIT>/<ANC>.tsv ---
export TRAIT="copd"
export WEIGHTS_ROOT="$HERE/snp_input"                # snp_input/<TRAIT>/<ANC>.tsv
export SNP_INPUT="$WEIGHTS_ROOT/$TRAIT/EUR.tsv"      # single-ancestry mode only

# --- options ---
export SCORE_MODE="both"                             # both | weighted | unweighted
export R2_THRESH="0"

# --- output (must be writable FROM COMPUTE NODES) ---
# On Sockeye jobs can only write to /scratch (/home and /arc/project are
# read-only on compute nodes), so every job's output goes under RUN_BASE.
export RUN_BASE="/scratch/your-allocation/$USER/prs_runs/$TRAIT"

# --- multi-ancestry ---
export RUN_ANCESTRY="0"                              # 1 = ancestry inference + routed scoring
export ANCESTRY_REF_PFILE="$HERE/reference/GRCh38_HGDP+1kGP_ALL"   # no extension; read-only is fine
export ANCESTRY_REF_LABEL_COL="SuperPop"
export ANCESTRY_REF_EXCLUDE="$HERE/reference/GRCh38_HGDP+1kGP.king.cutoff.out.id"   # related samples to drop
# export ANCESTRY_REF_CACHE="$HERE/ancestry_ref_cache" # must be writable

cfg() { bash -c "source '$HERE/config.sh'; echo \"\$$1\""; }   # resolved config value

# Copy the rsID conversion results (written on /scratch) into the weights folder.
rsids_copy() {
  local work weights
  work="$(cfg RESOLVE_WORK)"; weights="$(cfg WEIGHTS_DIR)"
  ls "$work"/*.tsv >/dev/null 2>&1 || { echo "[ERROR] no results in $work - did the job finish? see $work/resolve.log"; exit 1; }
  for f in "$work"/*.tsv; do
    case "$f" in
      *.unmatched.tsv) cp "$f" "$weights/pgs_raw/" ;;
      *)               cp "$f" "$weights/" ;;
    esac
  done
  cp "$work/resolve.log" "$weights/pgs_raw/"
  echo "[DONE] rsID weights files copied to $weights:"
  grep "matched" "$weights/pgs_raw/resolve.log" || true
}

# Install the reference-panel rsID .pvar.zst (written on /scratch) next to the
# panel as <prefix>_rsid, linking the unchanged .pgen/.psam under that name.
refids_copy() {
  local work src dst
  work="$(cfg REF_RSID_WORK)"; src="$(cfg ANCESTRY_REF_PFILE)"; src="${src%_rsid}"; dst="${src}_rsid"
  [[ -f "$work/ref_rsid.pvar.zst" ]] || { echo "[ERROR] no result in $work - did the job finish? see $work/ref_rsid.log"; exit 1; }
  cp "$work/ref_rsid.pvar.zst" "${dst}.pvar.zst"
  ln -sf "$(basename "$src").pgen" "${dst}.pgen"
  ln -sf "$(basename "$src").psam" "${dst}.psam"
  cp "$work/ref_rsid.log" "${dst}.convert.log"
  echo "[DONE] rsID reference panel: $dst  (.pvar.zst + links to the original .pgen/.psam)"
  grep "variants get an rsID\|DONE" "${dst}.convert.log" || true
  echo "Now set in submit.local.sh:  export ANCESTRY_REF_PFILE=\"$dst\""
}

case "${1:-submit}" in
  submit) exec bash "$HERE/submit.sh" ;;
  setup)  exec bash "$HERE/scripts/setup_ancestry_reference.sh" ;;
  check)  DEBUG_CONFIG=1 bash -c "source '$HERE/config.sh'" ;;
  rsids)
    RAW="$(cfg WEIGHTS_DIR)/pgs_raw"; WORK="$(cfg RESOLVE_WORK)"
    [[ -d "$RAW" ]] || { echo "[ERROR] put the raw weights files in $RAW first"; exit 1; }
    mkdir -p "$WORK"
    echo "[INFO] submitting; waiting for the job to finish (progress: tail -f $WORK/resolve.log)"
    # --chdir: Sockeye refuses jobs whose working directory is in /arc/project
    sbatch --wait --chdir="$WORK" --export=ALL,CONFIG="$HERE/config.sh",SUBMIT_DIR="$HERE" \
      --output="$WORK/resolve_%j.out" --error="$WORK/resolve_%j.err" \
      "$HERE/slurm/resolve_pgs_rsids.slurm" \
      || { echo "[ERROR] job failed - see $WORK/resolve.log and $WORK/resolve_*.err"; exit 1; }
    rsids_copy ;;
  rsids-copy) rsids_copy ;;
  refids)
    SRC="$(cfg ANCESTRY_REF_PFILE)"; WORK="$(cfg REF_RSID_WORK)"
    [[ "$SRC" != *_rsid ]] || { echo "[ERROR] ANCESTRY_REF_PFILE already points at an _rsid panel ($SRC) - set it back to the original to rebuild"; exit 1; }
    [[ -f "${SRC}.pgen" ]] || { echo "[ERROR] reference panel not found: ${SRC}.pgen"; exit 1; }
    mkdir -p "$WORK"
    echo "[INFO] submitting; waiting for the job to finish (progress: tail -f $WORK/ref_rsid.log)"
    sbatch --wait --chdir="$WORK" --export=ALL,CONFIG="$HERE/config.sh" \
      --output="$WORK/ref_rsid_%j.out" --error="$WORK/ref_rsid_%j.err" \
      "$HERE/slurm/rsid_reference.slurm" \
      || { echo "[ERROR] job failed - see $WORK/ref_rsid.log and $WORK/ref_rsid_*.err"; exit 1; }
    refids_copy ;;
  refids-copy) refids_copy ;;
  *) echo "usage: $0 [submit|setup|check|rsids|rsids-copy|refids|refids-copy]"; exit 1 ;;
esac
